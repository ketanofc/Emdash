# KEY_ENCRYPTION_SECRET: 32 random bytes base64-encoded (openssl rand -base64 32)
# Used server-side only to AES-256-GCM encrypt/decrypt provider API keys.
KEY_ENCRYPTION_SECRET=""

# Administrator credentials for Emdash Control Plane (/admin)
# Automatically initialized and seeded into the local store on first boot if missing.
ADMIN_EMAIL="admin@emdash.build"
ADMIN_PASSWORD="Emdash@Admin2026!"

# SITE_ORIGIN / APP_URL: Allowed origin for CORS and self-referential links.
APP_URL="http://localhost:3000"
SITE_ORIGIN="http://localhost:3000"

# Supabase configuration (optional locally; required for managed Supabase mode)
# In Supabase Dashboard -> Project Settings -> API:
# 1. Project URL -> VITE_SUPABASE_URL
VITE_SUPABASE_URL=""
# 2. Project API Keys -> "anon" "public" -> VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=""
# 3. Project API Keys -> "service_role" "secret" -> SUPABASE_SERVICE_ROLE_KEY (Server-only)
SUPABASE_SERVICE_ROLE_KEY=""

# (Optional) Set to "true" only if you deploy Deno Edge Functions using `supabase functions deploy`
# When unset or "false", all APIs route through the Node/Express/Vercel server with zero 404s.
VITE_USE_SUPABASE_EDGE_FUNCTIONS="false"

# GitHub OAuth App credentials (for Web Agent GitHub integration)
# Create at: GitHub -> Settings -> Developer settings -> OAuth Apps
# Callback URL: https://emdash.world/api/github/callback (or http://localhost:3000/api/github/callback)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""


